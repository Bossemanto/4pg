  {
    "slug": "about-us",
    "title": "About Us",
    "blocks": [
      {
        "tag": "p",
        "text": "4PG Vision"
      },
      {
        "tag": "h3",
        "text": "Creating Timeless Classics: 4PG Record Label is Dedicated to Preserving the Best Music of Today and Tomorrow."
      },
      {
        "tag": "p",
        "text": "4PG Record Label is an independent music imprint committed to authentic artistry, creative freedom, and artist-first development."
      },
      {
        "tag": "p",
        "text": "Rooted in passion and dedicated to sonic excellence, 4PG provides the infrastructure, strategic guidance, and creative platform for visionary talent to thrive globally."
      },
      {
        "tag": "p",
        "text": "With flagship artist Aram Jay and a dedicated management and operations team led by Partehad, 4PG is crafting a distinctive legacy in contemporary music."
      }
    ],
